---
import "../styles/v2.css";

/**
 * Versão 2, guardada em /v2. A página principal (index.astro) voltou a ser a v1.
 * Pixel da Meta e Clarity ligados.
 */
const rastrear = true;

const evento = {
  cidade: "Campinas",
  dataBarra: "5 de dezembro",
  dataShow: "Dia 5 de dezembro (Sábado)",
  horario: "Credenciamento às 8h30 · Treinamento das 9h às 17h",
  casa: "Tênis Clube de Campinas",
  endereco: "R. Cel. Quirino, 1346 — Cambuí, Campinas — SP, 13015-330",
  video: "",
  vendidos: 78,
  lugares: 23,
  produtora: "G&R Instituto Educacional",
  telefone: "(19) 99432-8278",
  links: {
    individual: "https://pay.hotmart.com/W107941887P?off=uh7firvc",
    socio: "https://pay.hotmart.com/W107941887P?off=1or0i69a",
  },
};

const palestrantes = [
  {
    nome: "Leandro Marcondes",
    papel: "Empresário, estrategista de negócios, mentor e autor.",
    bio: [
      "Com trajetória internacional e experiência na realização de grandes eventos de desenvolvimento pessoal e empresarial, Leandro esteve à frente da operação brasileira responsável por trazer ao país nomes internacionais como Jordan Belfort, o Lobo de Wall Street, T. Harv Eker, autor de Os Segredos da Mente Milionária, e Nick Vujicic.",
      "Diretamente de Londres para compartilhar experiências e conhecimentos sobre mentalidade, desenvolvimento pessoal e negócios.",
    ],
    foto: "/images/leandro.webp",
  },
  {
    nome: "Guaciara Fornaciari",
    papel: "Empresária, fonoaudióloga, professora e autora.",
    bio: [
      "Fundadora do Doutora Escola, Guaciara reúne sua experiência como empresária e educadora para abordar o desenvolvimento humano, a comunicação, as relações e a inteligência emocional.",
    ],
    foto: "/images/guaciara.webp",
  },
];

const depoimentos = [
  "6FwxZEKQaC0",
  "kdY579l18To",
  "nP8JC4RUjfs",
];

const cta = "Quero meu ingresso";
const ctaHero = "Sim, quero descobrir agora";
const heroFundo = "/images/hero-leandro.webp";
const mapa =
  "https://www.google.com/maps/search/?api=1&query=" +
  encodeURIComponent("Tênis Clube de Campinas, R. Cel. Quirino, 1346, Cambuí, Campinas - SP");
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {rastrear && <script is:inline>
      /* Pixel e Clarity entram na fila agora e só baixam o script na primeira interação
         (ou 3 s depois do load), para não disputar banda com a primeira tela. */
      (function (w, d) {
        if (w.fbq) return;
        var n = (w.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        });
        if (!w._fbq) w._fbq = n;
        n.push = n;
        n.loaded = true;
        n.version = "2.0";
        n.queue = [];
        w.clarity = w.clarity || function () {
          (w.clarity.q = w.clarity.q || []).push(arguments);
        };

        var carregado = false;
        var gatilhos = ["pointerdown", "keydown", "touchstart", "scroll"];
        function carregar() {
          if (carregado) return;
          carregado = true;
          gatilhos.forEach(function (e) { w.removeEventListener(e, carregar); });
          ["https://connect.facebook.net/en_US/fbevents.js", "https://www.clarity.ms/tag/yujxos97gk"].forEach(function (src) {
            var s = d.createElement("script");
            s.async = true;
            s.src = src;
            d.head.appendChild(s);
          });
        }
        gatilhos.forEach(function (e) { w.addEventListener(e, carregar, { passive: true }); });
        w.addEventListener("load", function () { setTimeout(carregar, 3000); });
      })(window, document);
      fbq("init", "456669227289266");
      fbq("track", "PageView");
      fbq("track", "ViewContent", {
        content_name: "RAROS",
        content_category: "Evento presencial",
        content_type: "product",
        content_ids: ["raros-nao-socio", "raros-socio"],
        currency: "BRL",
      });
    </script>}
    <meta name="theme-color" content="#07080b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>RAROS · Descubra em que temperatura está o seu termostato · Campinas, 5/12</title>
    <meta
      name="description"
      content="Sábado, 5 de dezembro, no Tênis Clube de Campinas. Lote 1 a R$ 97 até 15 de novembro. Descubra em que temperatura o seu termostato está regulado."
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content="RAROS · Em que temperatura está o seu termostato?" />
    <meta
      property="og:description"
      content="Sábado, 5 de dezembro, no Tênis Clube de Campinas. Lote 1 a R$ 97 até domingo, 15 de novembro."
    />
    <meta property="og:image" content="https://vivasuamissao.top/images/hero-leandro.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" as="image" href={heroFundo} type="image/webp" fetchpriority="high" />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Inter:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,500;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {rastrear && <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        src="https://www.facebook.com/tr?id=456669227289266&ev=PageView&noscript=1"
        alt=""
      />
    </noscript>}
    <div id="palco">

    {/*
      PENDÊNCIAS DE CONTEÚDO (não aparecem na página). Preencher quando houver o dado real:
      1. Temas do treinamento, hora a hora (seção "Como é o dia").
      2. O que a pessoa leva (material, certificado, etc.).
      3. O ingresso inclui coffee break e almoço? (FAQ "Tem intervalo e horário de almoço?").
      4. Haverá oferta de outros produtos ou mentorias no evento? Dizer sim ou não no FAQ.
      5. Como é a dinâmica de networking (a pessoa precisa se apresentar ou falar em público?).
      6. Se houver virada de lote, data e novo valor: só então colocar urgência na página.
      7. Legenda nos depoimentos: nome, cargo e o que mudou para a pessoa.
      8. Confirmar que os 3 depoimentos são mesmo de edições anteriores (a página já diz que foram em outros locais).
      9. Confirmar o ano da pesquisa do Sebrae-SP (9,3 h) antes de publicar.
      10. Confirmar se o parcelamento em até 12x está ativo na Hotmart.
      11. Quando houver resposta, entram no FAQ: "Vai ter venda de outro produto lá dentro?" e
          "Vou precisar me expor na frente da sala?". Antes disso, a página não promete nenhum dos dois.
      12. Bloco "O que o dia treina" (conversa difícil, pausa antes de decidir, delegar com limite): só com os temas confirmados.
    */}

    <!-- 1. Barra fixa: informação real, sem cronômetro -->
    <header class="topbar">
      <div class="topbar-inner">
        <p class="topbar-frase" data-edit><strong>TÊNIS CLUBE DE CAMPINAS - CAMBUÍ - 05 DE DEZEMBRO - 09:00 às 17:00</strong></p>
        <a class="topbar-btn" href="#porque">PORQUE IR NESSE EVENTO?</a>
      </div>
    </header>

    <main>
      <!-- 2. Hero: seleciona o leitor, nomeia a dor em palavras dele e diz o que é -->
      <section class="hero" style={`--hero: url('${heroFundo}')`}>
        <div class="wrap wrap-820">
          <div class="hero-texto">
            <div class="hero-intro">
              <h1 data-edit>O Primeiro Treinamento Interativo de Liderança com Inteligência Emocional de 8 horas no Tênis Clube de Campinas.</h1>
              <p class="hero-sub destaque-ouro" data-edit>
                Descubra o segredo de quem prospera com leveza, ri mais e não vive apagando incêndio.
              </p>
            </div>
            <img
              class="hero-foto"
              src={heroFundo}
              alt="Leandro Marcondes falando para a plateia"
              width="682"
              height="1024"
              fetchpriority="high"
            />
            <a class="btn btn-lg hero-cta" href="#ingressos">{ctaHero}</a>
            <p class="nota" data-edit>Entenda por que esse treinamento <strong>é sucesso por onde ele passa.</strong></p>
          </div>
        </div>
      </section>

      <!-- 3. Vídeo (opcional: preencha "video" no topo do arquivo para exibir) -->
      {evento.video && (
        <section class="video-box">
          <iframe
            src={evento.video}
            title="Apresentação do evento RAROS"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </section>
      )}

      <!-- 5. Edições anteriores -->
      <section class="edicao">
        <div class="elementor-heading-title" aria-hidden="true">▼</div>
        <div class="edicao-video depo-video" data-id="FT1ItsVS15U" data-titulo="Edições anteriores" data-rotulo="Assistir edições anteriores">
          <button type="button" class="depo-capa" aria-label="Assistir edições anteriores">
            <img
              src="/images/yt/FT1ItsVS15U.webp"
              alt=""
              width="480"
              height="360"
              loading="lazy"
              decoding="async"
            />
            <span class="depo-play" aria-hidden="true"></span>
          </button>
        </div>
        <img
          class="diferenciais"
          src="/images/diferenciais.jpg"
          alt="Aprendizagem divertida, networking guiado, ambiente seguro e treinador de Londres"
          width="1024"
          height="254"
          loading="lazy"
          decoding="async"
        />
      </section>

      <!-- 6. Reconhecimento: as cenas que o público descreve (clusters A, B, C e D da pesquisa) -->
      <section class="secao reconhece" id="porque">
        <div class="wrap">
          <h2 data-edit>Preparado para ter aquela ideia…<br /><span class="destaque-ouro">…que vai fazer seus olhos brilharem na hora?</span></h2>
          <p class="desce centro">Entenda aqui embaixo ▼</p>
          <div class="grade-3 experiencias">
            <article class="card">
              <img class="redonda" src="/images/ambiente-4-480.webp" alt="Participantes interagindo durante o treinamento" width="240" height="240" loading="lazy" decoding="async" />
              <h3 data-edit>8 horas de descobertas, interação e boas risadas…</h3>
              <p data-edit>
                Chega de palestras chatas, slides infinitos e teoria que dá sono! No Treinamento
                Interativo de Liderança com Inteligência Emocional, você participa do primeiro minuto
                até o final — você nem vai sentir a hora passando! O que mais surpreende são os
                momentos de interação divertidos, onde você se identifica com cada situação real, dá
                risada e ainda volta para casa com aquela sensação boa de ter feito novos amigos.
              </p>
            </article>
            <article class="card">
              <img class="redonda" src="/images/mk/edicao-networking.jpg" alt="Empresários conversando durante o evento" width="240" height="240" loading="lazy" decoding="async" />
              <h3 data-edit>No clube mais badalado de Campinas, no coração do Cambuí</h3>
              <p data-edit>
                Já imaginou combinar ideias que viram a chave, boas risadas e conexões com gente
                interessante? É essa experiência completa que levamos para você no Tênis Clube de
                Campinas — o endereço mais charmoso, tradicional e disputado da cidade.
              </p>
            </article>
            <article class="card">
              <img class="redonda" src="/images/card-energia-480.webp" alt="Participantes rindo durante o treinamento" width="240" height="240" loading="lazy" decoding="async" />
              <h3 data-edit>Termine o dia com a energia lá no teto</h3>
              <p data-edit>
                A experiência mais leve e marcante que você pode ter com seu parceiro de negócios,
                sua equipe ou amigos. Traga a sua turma para o Cambuí, viva cada momento na prática
                e saia sem querer que o sábado acabe. Esse dia merece ser compartilhado!
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- 10. Depoimentos em vídeo -->
      <section class="secao secao-suave depoimentos">
        <div class="wrap">
          <h2>O que dizem quem já assistiu ao treinamento:</h2>
          <div class="depo-videos">
            {depoimentos.map((id) => (
              <div class="depo-video" data-id={id}>
                <button type="button" class="depo-capa" aria-label="Assistir depoimento">
                  <img
                    src={`/images/yt/${id}.webp`}
                    alt=""
                    width="480"
                    height="360"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="depo-play" aria-hidden="true"></span>
                </button>
              </div>
            ))}
          </div>
          <div class="ultimo">
            <h2 class="centro">TODO EVENTO É TRANSFORMADOR</h2>
            <p class="apoio centro">Olha como foi no último</p>
            <div class="ultimo-fotos">
              {[
                "Plateia durante o treinamento",
                "Participantes reunidos no palco",
                "Participantes conversando no intervalo",
                "Participantes rindo durante uma dinâmica",
                "Plateia levantando as mãos durante o treinamento",
                "Plateia de pé fazendo uma dinâmica com os braços para cima",
              ].map((alt, i) => (
                <img
                  src={`/images/ultimo-${i + 1}.webp`}
                  alt={alt}
                  width="640"
                  height="480"
                  loading="lazy"
                  decoding="async"
                />
              ))}
            </div>
            <p class="centro"><a class="btn" href="#ingressos">Garantir meu ingresso</a></p>
          </div>
        </div>
      </section>

      <!-- 9. Palestrantes (autoridade antes do ingresso) -->
      <section class="secao palestrantes">
        <div class="wrap">
          <p class="kicker">Treinadores</p>
          <h2>Conheça quem vai conduzir essa experiência</h2>
          <div class="grade-3">
            {palestrantes.map((p) => (
              <article class="card palestrante">
                <img class="redonda" src={p.foto} alt={p.nome} width="240" height="240" loading="lazy" decoding="async" />
                <h3>{p.nome}</h3>
                <p class="papel">{p.papel}</p>
                {p.bio.map((paragrafo) => (
                  <p class="bio-palestrante">{paragrafo}</p>
                ))}
              </article>
            ))}
          </div>
          <p class="centro"><a class="btn" href="#ingressos">{ctaHero}</a></p>
        </div>
      </section>

      <!-- 12. Logística -->
      <section class="secao secao-noite logistica">
        <div class="wrap wrap-760">
          <h2>Quando e onde</h2>
          <p class="icone" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="3" y="4.5" width="18" height="16.5" rx="2" /><path d="M3 9.5h18M8 2.5v4M16 2.5v4" /></svg>
          </p>
          <p class="quando" data-campo="dataShow">{evento.dataShow}</p>
          <p class="horario">Credenciamento às 8h30 · Treinamento das 9h às 17h, com intervalos e horário de almoço</p>
          <p class="icone" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
          </p>
          <p class="onde" data-campo="casa">{evento.casa}</p>
          <p class="endereco" data-campo="endereco">{evento.endereco}</p>
          <p class="mapa"><a href={mapa} target="_blank" rel="noopener">Ver no mapa →</a></p>
        </div>
      </section>

      <!-- 13. Oferta: preço, o que inclui e risco, sem urgência inventada -->
      <section class="secao secao-suave oferta" id="ingressos">
        <div class="wrap">
          <h2 data-edit><strong>Falta pouco para você ter o dia mais transformador da sua vida!</strong></h2>
          <p class="aviso" data-edit>
            Nota: se clicar em "comprar agora" e nada acontecer, é porque os ingressos esgotaram. Pedimos desculpas.
          </p>
          <div class="escassez">
            <div class="escassez-topo">
              <span>Ingressos vendidos</span>
              <strong><span data-campo="vendidos">{evento.vendidos}</span>%</strong>
            </div>
            <div class="trilho" aria-hidden="true">
              <span style={`width: ${evento.vendidos}%`}></span>
            </div>
            <p>
              <span data-edit>Restam apenas</span>
              <strong><span data-campo="lugares">{evento.lugares}</span></strong>
              <span data-edit>lugares neste lote</span>
            </p>
          </div>

          <div class="grade-ingressos">
            <article class="lote lote-destaque">
              <span class="selo">⭐ O mais vendido</span>
              <img
                class="lote-ingresso"
                src="/images/ingresso-raros.webp"
                alt="Ingresso do RAROS: 5 de dezembro, sábado, no Tênis Clube de Campinas"
                width="420"
                height="747"
                loading="lazy"
                decoding="async"
              />
              <p class="lote-nome">Lote 1</p>
              <p class="lote-tipo"><strong>Não sócio</strong></p>
              <p class="preco-linha">
                <span class="preco-de">R$ 397</span>
                <span class="preco-moeda">R$</span><span class="preco">97</span>
              </p>
              <p class="a-vista">à vista ou em até 12x no cartão</p>
              <p class="lote-nota">Em 16/11 o ingresso passa a R$ 197. Sem exceções.</p>
              <a
                class="btn btn-bloco"
                href={evento.links.individual}
                data-checkout
                data-content-id="raros-nao-socio"
                data-content-name="Ingresso não sócio RAROS lote 1"
                data-value="97"
                data-num-items="1"
              >Garantir ingresso por R$&nbsp;97</a>
              <p class="via">Compra segura pela Hotmart</p>
            </article>

            <article class="lote lote-secundario">
              <img
                class="lote-ingresso"
                src="/images/ingresso-raros.webp"
                alt="Ingresso do RAROS: 5 de dezembro, sábado, no Tênis Clube de Campinas"
                width="420"
                height="747"
                loading="lazy"
                decoding="async"
              />
              <p class="lote-nome">Sócio do Clube</p>
              <p class="preco-linha"><span class="preco-moeda">R$</span><span class="preco">47</span></p>
              <p class="a-vista">em qualquer lote</p>
              <p class="lote-nota">Economia de até R$ 350 em relação ao Lote 3</p>
              <p class="lote-nota">Obrigatório apresentar a carteirinha</p>
              <a
                class="btn btn-bloco"
                href={evento.links.socio}
                data-checkout
                data-content-id="raros-socio"
                data-content-name="Ingresso sócio do clube RAROS"
                data-value="47"
                data-num-items="1"
              >Garantir ingresso por R$&nbsp;47</a>
            </article>
          </div>
        </div>
      </section>

      <!-- 14. Como funciona -->
      <section class="secao passos">
        <div class="wrap wrap-960">
          <h2>Comprar é simples e rápido</h2>
          <p class="apoio">Em menos de 2 minutos seu lugar está garantido</p>
          <div class="grade-3">
            <article class="passo">
              <p class="numero">1</p>
              <h3>Escolha seu ingresso</h3>
              <p>Clique no botão do ingresso e finalize o pagamento na Hotmart: cartão, Pix ou boleto.</p>
            </article>
            <article class="passo">
              <p class="numero">2</p>
              <h3>Receba no e-mail</h3>
              <p>Assim que o pagamento é confirmado, o seu acesso chega na hora no seu e-mail.</p>
            </article>
            <article class="passo">
              <p class="numero">3</p>
              <h3>Apresente na porta</h3>
              <p>No credenciamento do Tênis Clube, a partir das 8h30, você faz o check-in pelo celular. Pronto, é só aproveitar o dia!</p>
            </article>
          </div>
        </div>
      </section>

      <!-- 15. Garantia concreta -->
      <section class="secao secao-noite garantia">
        <div class="wrap wrap-680">
          <p class="escudo" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path class="escudo-forma" d="M12 3 4.5 6v5.5c0 4.4 3.1 8.3 7.5 9.5 4.4-1.2 7.5-5.1 7.5-9.5V6L12 3Z" /><path class="escudo-ok" d="m8.8 12.2 2.4 2.4 4.2-4.6" /></svg>
          </p>
          <h2>100% de garantia na sua compra</h2>
          <p>
            Você pode pedir o reembolso de 100% do valor pago até 3 dias antes do evento, ou seja,
            até 2 de dezembro de 2026. O pedido é feito diretamente pela Hotmart, sem burocracia.
          </p>
          <p>
            Depois desse prazo, e depois do evento, não há reembolso.
            <a href="#termos">Veja os termos e condições.</a>
          </p>
          <a class="btn btn-claro" href="#ingressos">{cta}</a>
          <img
            class="selos-garantia"
            src="/images/selos-garantia.png"
            alt="Compra segura, satisfação garantida e privacidade protegida"
            width="300"
            height="36"
            loading="lazy"
            decoding="async"
          />
        </div>
      </section>

      <!-- 16. Quem está realizando -->
      <section class="secao">
        <div class="wrap wrap-1100 sobre">
          <div class="sobre-grid">
            <div class="sobre-cabeca">
              <h2>Apoio da Diretoria Cultural do Tênis Clube de Campinas</h2>
              <div class="realizacao">
                <span class="realizacao-rotulo">Diretora Cultural do Tênis Clube de Campinas</span>
                <strong>Ana Clara de Mello e Silva</strong>
                <span>Evento da Diretoria Cultural · Presidente Antônio Grassi Júnior</span>
              </div>
            </div>
            <img
              class="sobre-foto"
              src="/images/ana-clara.webp"
              alt="Ana Clara de Mello e Silva, Diretora Cultural do Tênis Clube de Campinas"
              width="480"
              height="640"
              loading="lazy"
              decoding="async"
            />
            <p class="sobre-bio" data-edit>
              Os RAROS é um encontro presencial de 1 dia no Tênis Clube de Campinas, apoiado
              pela Diretoria Cultural. O Networking é uma ação idealizada e desenvolvida por esta
              diretoria, para aproximar empresários, empreendedores e líderes.
            </p>
          </div>
        </div>
