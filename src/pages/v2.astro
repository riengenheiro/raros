    <script is:inline>
      (() => {
        if (!document.querySelector(".depo-video")) return;

        const capa = (id, rotulo) => `
          <button type="button" class="depo-capa" aria-label="${rotulo}">
            <img src="/images/yt/${id}.webp" alt="" width="480" height="360" />
            <span class="depo-play" aria-hidden="true"></span>
          </button>`;

        document.addEventListener("click", (evento) => {
          const card = evento.target.closest(".depo-video");
          if (!card || card.querySelector("iframe")) return;

          document.querySelectorAll(".depo-video").forEach((outro) => {
            if (outro !== card && outro.querySelector("iframe")) {
              outro.innerHTML = capa(outro.dataset.id, outro.dataset.rotulo || "Assistir depoimento");
            }
          });

          const frame = document.createElement("iframe");
          frame.src = `https://www.youtube.com/embed/${card.dataset.id}?autoplay=1&rel=0&playsinline=1`;
          frame.title = card.dataset.titulo || "Depoimento de participante";
          frame.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
          frame.allowFullscreen = true;
          card.replaceChildren(frame);
        });
      })();
    </script>
    <script is:inline>
      document.addEventListener("click", (eventoClique) => {
        const link = eventoClique.target.closest("[data-checkout]");
        if (!link || typeof fbq !== "function") return;
        const valor = Number(link.dataset.value);
        const quantidade = Number(link.dataset.numItems);
        if (!link.dataset.contentId || !Number.isFinite(valor) || !Number.isFinite(quantidade)) return;
        fbq("track", "InitiateCheckout", {
          content_ids: [link.dataset.contentId],
          content_name: link.dataset.contentName,
          content_category: "Evento presencial",
          content_type: "product",
          contents: [{ id: link.dataset.contentId, quantity: quantidade, item_price: valor }],
          num_items: quantidade,
          value: valor,
          currency: "BRL",
        });
      });
    </script>
    <script is:inline>
      (() => {
        const caixa = document.querySelector(".contador");
        if (!caixa) return;
        const fim = new Date(caixa.dataset.fim).getTime();
        const campos = {
          dias: caixa.querySelector('[data-unidade="dias"]'),
          horas: caixa.querySelector('[data-unidade="horas"]'),
          minutos: caixa.querySelector('[data-unidade="minutos"]'),
          segundos: caixa.querySelector('[data-unidade="segundos"]'),
        };
        const rotulo = caixa.querySelector(".contador-rotulo");
        const topo = document.getElementById("topbar-timer");
        const dois = (n) => String(n).padStart(2, "0");
        const atualizar = () => {
          const falta = fim - Date.now();
          if (falta <= 0) {
            if (rotulo) rotulo.textContent = "O lote 1 encerrou em 15/11, às 23h59.";
            caixa.querySelector(".contador-numeros")?.remove();
            if (topo) topo.textContent = "Encerrou";
            return;
          }
          const total = Math.floor(falta / 1000);
          const dias = Math.floor(total / 86400);
          const horas = Math.floor((total % 86400) / 3600);
          const minutos = Math.floor((total % 3600) / 60);
          const segundos = total % 60;
          campos.dias.textContent = dois(dias);
          campos.horas.textContent = dois(horas);
          campos.minutos.textContent = dois(minutos);
          campos.segundos.textContent = dois(segundos);
          if (topo) topo.textContent = `${dois(dias)}d ${dois(horas)}h ${dois(minutos)}m`;
        };
        atualizar();
        setInterval(atualizar, 1000);
      })();
    </script>
