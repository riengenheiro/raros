            ))}
          </div>
        </div>
      </section>

      <!-- 14. Quem está por trás -->
      <section class="secao">
        <div class="wrap wrap-1100 sobre">
          <div class="sobre-grid">
            <img
              class="sobre-foto"
              src="/images/organizador.webp"
              alt="RAROS: encontro presencial no Tênis Clube de Campinas"
