      <!-- 9. Logística -->
      <section class="secao secao-noite logistica">
        <div class="wrap wrap-760">
          <h2>Reserve seu lugar nos RAROS</h2>
          <p class="apoio">
            Um único dia, presencial, no Tênis Clube de Campinas. As vagas são limitadas.
          </p>
          <p class="icone" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="3" y="4.5" width="18" height="16.5" rx="2" /><path d="M3 9.5h18M8 2.5v4M16 2.5v4" /></svg>
          </p>
          <p class="quando" data-campo="dataShow">{evento.dataShow}</p>
          <p class="icone" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
          </p>
          <p class="onde" data-campo="casa">{evento.casa}</p>
          <p class="endereco" data-campo="endereco">{evento.endereco}</p>
          <p class="mapa"><a href={mapa} target="_blank" rel="noopener">Ver no mapa →</a></p>
        </div>
      </section>

      <!-- 10. Oferta -->
      <section class="secao secao-suave oferta" id="ingressos">
        <div class="wrap">
          <h2>Garanta sua vaga nos RAROS</h2>
          <p class="aviso">
            Nota: se ao clicar nos botões abaixo nada acontecer, é porque as vagas esgotaram.
