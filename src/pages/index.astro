---
import "../styles/global.css";

/**
 * Campos do evento.
 * A copy da página está no HTML abaixo — edite o texto direto em cada bloco.
 *
 * Imagens: todas ficam em /public/images. Para trocar, basta substituir o arquivo
 * mantendo o mesmo nome (lista completa no final da conversa com o assistente).
 */
const evento = {
  cidade: "Campinas",
  dataBarra: "5 de dezembro",
  dataShow: "Dia 5 de dezembro (Sábado)",
  casa: "Tênis Clube de Campinas",
  endereco: "R. Cel. Quirino, 1346 — Cambuí, Campinas — SP, 13015-330",
  video: "",
  vendidos: 78,
  lugares: 23,
  produtora: "G&R Instituto Educacional",
  razaoSocial: "G&R INSTITUTO EDUCACIONAL LTDA",
  cnpj: "39.969.764/0001-25",
  telefone: "(19) 99432-8278",
  whatsapp: "(XX) 9 XXXX-XXXX",
  links: {
    individual: "https://pay.hotmart.com/W107941887P?off=vyswj0sp",
    combo: "https://pay.hotmart.com/W107941887P?off=bndwz2ti",
    socio: "https://pay.hotmart.com/W107941887P?off=1or0i69a",
  },
};

const palestrantes = [
  {
    nome: "Leandro Marcondes",
    papel: "Empresário · Estrategista de negócios · Mentor · Autor",
    foto: "/images/leandro.jpg",
  },
  {
    nome: "Guaciara Fornaciari",
    papel: "Fundadora do Doutora Escola",
    foto: "/images/guaciara.jpg",
  },
  {
    nome: "Tatiane Soldam",
    papel: "Gestora e co-fundadora",
    foto: "/images/tatiane.jpg",
  },
];

const depoimentos = [
  "6FwxZEKQaC0",
  "kdY579l18To",
  "nP8JC4RUjfs",
];

const cta = "Sim, quero fazer parte dos RAROS";
const heroFundo = "/images/hero.webp";
const mapa =
  "https://www.google.com/maps/search/?api=1&query=" +
  encodeURIComponent("Tênis Clube de Campinas, R. Cel. Quirino, 1346, Cambuí, Campinas - SP");
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#07080b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>RAROS | Encontro presencial no Tênis Clube de {evento.cidade}</title>
    <meta
      name="description"
      content="RAROS: um dia de treinamento presencial no Tênis Clube de Campinas para empresários, empreendedores e líderes que querem abrir portas e fechar grandes parcerias."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Playfair+Display:ital,wght@0,500;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div id="palco">
    <!-- 1. Barra fixa -->
    <header class="topbar">
      <div class="topbar-inner">
        <p class="topbar-frase" data-edit><strong>VEJA:</strong> Como Empresários, Empreendedores e Líderes Estão Fechando Grandes Parcerias em Salas Que 99% do Mercado Nem Sabe Que Existem</p>
        <p class="topbar-timer" id="topbar-timer" aria-live="polite">15:00</p>
      </div>
    </header>

    <main>
      <!-- 2. Hero + headline -->
      <section class="hero" style={`--hero: url('${heroFundo}')`}>
        <div class="wrap wrap-820">
          <div class="hero-intro">
            <p class="hero-olho" data-edit><span class="frase">"Sentado na mesa dos grandes…</span> <span class="frase">mesmo que você não conheça quase ninguém…</span> <span class="frase">no AMBIENTE CERTO!"</span></p>
            <h1>
              <span data-edit><span class="frase"><span class="frase">O Que Pode Acontecer</span> <span class="frase">Com o Seu Negócio</span></span> <span class="frase"><span class="frase">Quando Você Está</span> <span class="frase">na Sala Certa,</span></span> <span class="frase">Com as Pessoas Certas?</span></span>
            </h1>
          </div>
          <div class="evento-resumo">
            <p class="evento-nome"><span class="frase">Inteligência Emocional</span> <span class="frase">para Liderar o Seu Negócio</span></p>
            <p class="evento-local">Um encontro restrito no Tênis Clube de Campinas.</p>
          </div>
          <a class="btn btn-lg hero-cta" href="#ingressos">{cta}</a>
          <p class="nota">
            <span class="frase">{evento.dataShow}</span> · <strong class="frase">Vagas limitadas</strong>
          </p>
          <img
            class="hero-foto"
            src="/images/hero.webp"
            alt="RAROS: encontro presencial no Tênis Clube de Campinas"
            width="1254"
            height="1254"
          />
          <p class="seta" aria-hidden="true">▼</p>
        </div>
      </section>

      <!-- 3. Vídeo (opcional: preencha "video" no topo do arquivo para exibir) -->
      {evento.video && (
        <section class="video-box">
          <iframe
            src={evento.video}
            title="Apresentação do evento RAROS"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </section>
      )}

      <!-- 4. Resumo do evento -->
      <section class="faixa-beneficios">
        <div class="wrap">
          <ul>
            <li>
              <strong>1 dia</strong>
              <span>de treinamento presencial</span>
            </li>
            <li>
              <strong>Networking</strong>
              <span>com empresários e líderes</span>
            </li>
            <li>
              <strong>Tênis Clube</strong>
              <span>de Campinas, no Cambuí</span>
            </li>
            <li>
              <strong>Vagas</strong>
              <span>limitadas</span>
            </li>
