            </article>
            <article class="passo">
              <p class="numero">3</p>
              <h3>Apresente na porta</h3>
              <p>Apresente seu ingresso no credenciamento do Tênis Clube. Pronto, é só aproveitar o dia!</p>
            </article>
          </div>
        </div>
      </section>

      <!-- 12. Garantia -->
      <section class="secao secao-noite garantia">
        <div class="wrap wrap-680">
          <p class="escudo" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path class="escudo-forma" d="M12 3 4.5 6v5.5c0 4.4 3.1 8.3 7.5 9.5 4.4-1.2 7.5-5.1 7.5-9.5V6L12 3Z" /><path class="escudo-ok" d="m8.8 12.2 2.4 2.4 4.2-4.6" /></svg>
          </p>
          <h2>100% de garantia na sua compra</h2>
          <p>
            Caso se arrependa da compra, você pode solicitar seu dinheiro de volta dentro do prazo
            de garantia, diretamente pela Hotmart. Tudo fácil e sem burocracia.
          </p>
          <a class="btn btn-claro" href="#ingressos">{cta}</a>
        </div>
      </section>

      <!-- 13. Palestrantes -->
      <section class="secao palestrantes">
        <div class="wrap">
          <p class="kicker">Palestrantes</p>
          <h2>Quem conduz o dia</h2>
          <div class="grade-3">
            {palestrantes.map((p) => (
              <article class="card palestrante">
                <img class="redonda" src={p.foto} alt={p.nome} width="240" height="240" />
                <h3>{p.nome}</h3>
                <p>{p.papel}</p>
