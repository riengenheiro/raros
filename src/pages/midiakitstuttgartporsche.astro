          <h2>Cento e quarenta lugares. Uma única sala. As pessoas que decidem.</h2>
          <p class="k4-lead">
            O {evento.nome} reúne, por um dia, sócios do {evento.casa} e empresários convidados em torno de inteligência
            emocional aplicada aos negócios. Um ambiente reservado, pensado para conversas que viram parcerias.
          </p>
          <p class="k4-lead">
            Composição prevista dos {evento.composicao.reduce((s, c) => s + c.qtd, 0)} lugares. É a meta de
            distribuição do RAROS, a ser validada com as inscrições.
          </p>

          <div class="k4-barra" role="img" aria-label={evento.composicao.map((c) => `${c.qtd} lugares, ${c.pct}%: ${c.rotulo}`).join("; ")}>
            {evento.composicao.map((c, i) => <span class={`k4-seg k4-seg-${i + 1}`} style={`width: ${c.pct}%`}></span>)}
          </div>
          <ul class="k4-legenda">
            {evento.composicao.map((c, i) => (
              <li>
                <i class={`k4-seg k4-seg-${i + 1}`} aria-hidden="true"></i>
                <strong>{c.qtd}</strong>
                <span>{c.rotulo} · {c.pct}%</span>
              </li>
            ))}
          </ul>
          <p class="k4-linha">{evento.porte}.</p>
          <p class="k4-fonte">O Clube de Networking é uma ação idealizada e desenvolvida pela Diretoria Cultural do {evento.casa}.</p>

          <div class="k4-clube">
            <h3 class="k4-sub">Contexto do Tênis Clube</h3>
            <p class="k4-fonte" style="margin: -8px 0 16px">
              Dados da base de sócios do clube. Não representam a audiência confirmada do RAROS.
            </p>
            <ul class="k4-grade k4-grade-4">
              {evento.perfilClube.map((n) => <li><strong>{n.valor}</strong><span>{n.rotulo}</span></li>)}
            </ul>
            <ul class="k4-grade k4-grade-3">
              {evento.clubeNumeros.map((n) => <li><strong>{n.valor}</strong><span>{n.rotulo}</span></li>)}
            </ul>
            <p class="k4-fonte">Fonte: dados do {evento.casa}. Evento exclusivo para maiores de 18 anos.</p>
          </div>
        </div>
      </section>

      <!-- 04 O dia -->
      <section class="k4-pag k4-claro">
        <div class="k4-wrap">
          <p class="k4-num"><i class="k4-filete" aria-hidden="true"></i>04 · O dia Porsche</p>
          <h2>Cada momento do dia, uma ideia para a marca</h2>
          <p class="k4-lead">
            {evento.data}, no {evento.casa}. {h.dia.detalhe}
          </p>
          <ol class="k4-dia">
            {h.dia.momentos.map((m) => (
              <li class={`k4-momento ${m.marca ? "k4-com-marca" : ""}`}>
                <strong>{m.hora}</strong>
                <i class="k4-filete" aria-hidden="true"></i>
                <div>
                  <h3>{m.nome}</h3>
                  <p>{m.ideia}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="k4-ideia-geral"><strong>{h.dia.ideia}</strong></p>
          <div class="k4-testdrive">
            <strong>{h.dia.testdrive.titulo}</strong>
            {h.dia.testdrive.texto}
          </div>
          <p class="k4-fonte">{evento.endereco}</p>
        </div>
      </section>

      <!-- 05 Conteúdo -->
      <section class="k4-pag">
        <div class="k4-wrap">
          <p class="k4-num"><i class="k4-filete" aria-hidden="true"></i>05 · Conteúdo</p>
          <h2>Quem conduz o dia</h2>
          <div class="k4-pals">
            {evento.palestrantes.map((p) => (
              <article class="k4-pal">
                <img src={p.foto} alt={p.nome} width="520" height="650" />
                <h3>{p.nome}</h3>
                <p class="k4-pal-papel">{p.papel}</p>
                <p class="k4-pal-texto">{p.texto}</p>
                <ul>
                  {p.numeros.map((n) => <li><strong>{n.valor}</strong><span>{n.rotulo}</span></li>)}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- 06 Formatos -->
      <section class="k4-pag k4-claro" id="formatos">
        <div class="k4-wrap">
          <p class="k4-num"><i class="k4-filete" aria-hidden="true"></i>06 · Parceria</p>
          <h2>Três formatos para a Stuttgart Porsche estar presente</h2>
          <p class="k4-lead">
            A experiência do patrocinador é o contato direto com a base de clientes: uma única sala, {evento.destaques[0].valor}
            lugares, com a Stuttgart Porsche presente do credenciamento ao coquetel.
          </p>
          <ul class="k4-experiencia">
            {h.experiencia.map((e) => (
              <li><strong>{e.titulo}</strong><span>{e.texto}</span></li>
            ))}
          </ul>
          <div class="k4-cotas">
            {h.cotas.map((c) => (
              <article class={`k4-cota ${c.destaque ? "k4-cota-destaque" : ""}`}>
                <h3>{c.nome}</h3>
                <p class="k4-cota-qtd">{c.quantidade}</p>
                <p class="k4-cota-resumo">{c.resumo}</p>
                <ul>{c.entregas.map((e) => <li>{e}</li>)}</ul>
                <p class="k4-cota-valor">Investimento apresentado em conversa</p>
              </article>
            ))}
          </div>
          <div class="k4-cta-linha">
            <p>Qual formato combina com a Stuttgart Porsche? Conversamos sobre entregas, momentos e exclusividade.</p>
            <a class="k4-botao" href={zap}>Agendar conversa</a>
          </div>
        </div>
      </section>

      <!-- 07 Monte a presença -->
      <section class="k4-pag k4-grafite" id="montar">
        <div class="k4-wrap">
          <p class="k4-num"><i class="k4-filete" aria-hidden="true"></i>07 · Sua presença, do seu jeito</p>
          <h2>Monte a presença da Stuttgart Porsche no RAROS</h2>
          <p class="k4-lead">
            Os formatos são um ponto de partida. Marque o que faz sentido para a marca e enviaremos a composição
            diretamente para a conversa. Nada aqui é definitivo: serve para começarmos pelo que a Stuttgart já tem em mente.
          </p>

          <form class="k4-montar" id="k4-montar" onsubmit="return false">
            <fieldset class="k4-passo">
              <legend>1. Qual linha Porsche estará presente?</legend>
              <div class="k4-opcoes k4-opcoes-2">
                {h.linhas.map((l, i) => (
                  <label class="k4-escolha">
                    <input type="radio" name="linha" value={l.valor} checked={i === 0} />
                    <span><strong>{l.valor}</strong><small>{l.texto}</small></span>
                  </label>
                ))}
              </div>
            </fieldset>

            <fieldset class="k4-passo">
              <legend>
                2. Em quais momentos?
                <small>Marque quantos quiser.</small>
              </legend>
              <div class="k4-opcoes k4-opcoes-2">
                {opcoesMomento.map((m) => (
                  <label class="k4-escolha">
                    <input type="checkbox" name="momento" value={m.nome} data-nivel={m.nivel} />
                    <span><em>{m.hora}</em><strong>{m.nome}</strong><small>{m.ideia}</small></span>
                  </label>
                ))}
              </div>
            </fieldset>

            <fieldset class="k4-passo">
              <legend>
                3. Test drive
                <small>O cadastro é feito durante o RAROS. O test drive acontece depois.</small>
              </legend>
              <div class="k4-opcoes k4-opcoes-1">
                <label class="k4-escolha">
                  <input type="checkbox" name="testdrive" checked />
                  <span>
                    <strong>Abrir cadastro de test drive para depois do evento</strong>
                    <small>Convidados interessados, com consentimento e sujeito à autorização do clube, deixam os dados e agendam com o Porsche Center Campinas, em data a combinar.</small>
                  </span>
                </label>
              </div>
            </fieldset>

            <fieldset class="k4-passo">
              <legend>
                4. Algo mais que a Stuttgart gostaria de incluir?
                <small>Uma linha, um convidado ou uma mensagem da marca.</small>
              </legend>
              <textarea class="k4-campo" name="obs" rows="3" placeholder="Escreva aqui, se quiser."></textarea>
            </fieldset>

            <div class="k4-resumo" aria-live="polite">
              <p class="k4-resumo-rotulo">Formato que combina com a sua escolha</p>
              <p class="k4-resumo-formato" id="k4-formato">Marque ao menos um momento</p>
              <p class="k4-resumo-texto" id="k4-resumo-texto">
                Assim que você escolher, mostramos o formato mais próximo. Depois ajustamos tudo juntos.
              </p>
              <a class="k4-botao" id="k4-enviar" href={zap}>Enviar esta composição</a>
            </div>
          </form>
        </div>
      </section>

      <!-- 08 Compromisso -->
      <section class="k4-pag k4-claro">
        <div class="k4-wrap">
          <p class="k4-num"><i class="k4-filete" aria-hidden="true"></i>08 · Nosso compromisso</p>
          <h2>Cuidar da marca é parte da proposta</h2>
          <p class="k4-lead">
            Sabemos o que a marca Porsche representa e o cuidado que a Stuttgart tem com ela. Por isso assumimos seis compromissos desde já.
          </p>
          <ul class="k4-compromissos">
            {h.compromissos.map((c) => (
              <li>
                <strong><i class="k4-filete" aria-hidden="true"></i>{c.titulo}</strong>
                <span>{c.texto}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- 09 Realização e visibilidade -->
      <section class="k4-pag">
        <div class="k4-wrap">
          <p class="k4-num"><i class="k4-filete" aria-hidden="true"></i>09 · Realização</p>
          <h2>Diretoria Cultural</h2>
          <p class="k4-lead">O RAROS é um evento da Diretoria Cultural do {evento.realizacao}.</p>
          <article class="k4-cultural">
            <img src="/images/mk/ana-clara.png" alt="Ana Clara de Mello e Silva, Diretora Cultural do Tênis Clube de Campinas" width="640" height="800" />
            <div>
              <span>Diretora Cultural do Tênis Clube de Campinas</span>
              <strong>Ana Clara de Mello e Silva</strong>
              <p>O encontro acontece dentro da proposta da Diretoria Cultural. O Clube de Networking é uma ação idealizada e desenvolvida por esta diretoria.</p>
            </div>
          </article>
          <ul class="k4-diretoria">
            {evento.diretoria.map((d) => <li><span>{d.cargo}</span><strong>{d.nome}</strong></li>)}
          </ul>

          <h3 class="k4-sub">Visibilidade antes do evento</h3>
          <div class="k4-visib">
            <p class="k4-visib-num">
              <strong>{seguidoresMil}</strong>
              <span>seguidores somados nos perfis dos palestrantes, do clube e na página BEE - Business Explosion Experience (Facebook)</span>
            </p>
            <p>
              Além da página oficial do evento e das telas digitais do clube, vistas por mais de 1.200 frequentadores por dia.
            </p>
          </div>

          <h3 class="k4-sub">Edições anteriores</h3>
          <p class="k4-fonte" style="margin: -8px 0 16px">Registros de edições realizadas em outros locais.</p>
          <ul class="k4-fotos">
            {evento.fotos.map((f) => (
              <li>
                <img src={f.src} alt={f.alt} width="480" height="600" loading="lazy" />
                <span>{f.legenda}</span>
              </li>
            ))}
          </ul>
          <div class="k4-videos">
            {evento.videos.map((v, i) => (
              <button
                type="button"
                class="k4-video"
                data-video={youtubeEmbed(v.url)}
                data-formato={v.url.includes("/shorts/") ? "vertical" : "horizontal"}
                data-titulo={`${v.titulo} · vídeo ${i + 1}`}
              >
                <img src={v.imagem} alt="" width="405" height="720" />
                <span class="k4-play" aria-hidden="true"></span>
                <span class="k4-video-txt">Assistir · vídeo {i + 1}</span>
              </button>
            ))}
          </div>

          <h3 class="k4-sub">O que dizem os participantes</h3>
          <div class="k4-depoimentos">
            {evento.depoimentos.map((d, i) => (
              <button
                type="button"
                class="k4-depo"
                data-video={youtubeEmbed(d.url)}
                data-formato="vertical"
                data-titulo={`Depoimento ${i + 1}`}
              >
                <span class="k4-depo-capa">
                  <img src={d.imagem} alt="" width="1080" height="1920" loading="lazy" />
                  <span class="k4-play" aria-hidden="true"></span>
                </span>
                <span class="k4-depo-txt">Assistir depoimento {i + 1}</span>
              </button>
            ))}
          </div>
        </div>
      </section>

      <!-- Contato -->
      <section class="k4-pag k4-final">
        <div class="k4-wrap">
          <div class="k4-contato">
            <p class="k4-rotulo"><i class="k4-filete" aria-hidden="true"></i>Será uma honra conversar com a Stuttgart Porsche</p>
            <p class="k4-contato-nome">{evento.contato.nome}</p>
            <p><a href={zap}>WhatsApp {evento.contato.telefone}</a></p>
            <p><a href={`mailto:${evento.contato.email}`}>{evento.contato.email}</a></p>
            <a class="k4-botao" href={zap}>Agendar conversa</a>
          </div>
          <p class="k4-rodape">
            {evento.nome} · {evento.casa} · {evento.endereco}<br />
            G&R INSTITUTO EDUCACIONAL LTDA · CNPJ: 39.969.764/0001-25
          </p>
        </div>
      </section>
    </main>

    <dialog class="k4-player" id="k4-player">
      <form method="dialog" class="k4-player-barra">
        <p class="k4-player-titulo"></p>
        <button type="submit" class="k4-player-fechar">Fechar</button>
      </form>
      <iframe title="Vídeo" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>
    </dialog>

    <script is:inline define:vars={{ whatsapp: evento.contato.whatsapp }}>
      // Janela de vídeo
      const dialog = document.querySelector("#k4-player");
      const frame = dialog.querySelector("iframe");
      const titulo = dialog.querySelector(".k4-player-titulo");

      document.querySelectorAll(".k4-video, .k4-depo").forEach((botao) => {
        botao.addEventListener("click", () => {
          const nome = botao.dataset.titulo || "Vídeo";
          frame.title = nome;
          titulo.textContent = nome;
          dialog.dataset.formato = botao.dataset.formato || "horizontal";
          frame.src = botao.dataset.video || "";
          dialog.showModal();
        });
      });
      dialog.addEventListener("close", () => { frame.src = ""; });
      dialog.addEventListener("click", (evento) => { if (evento.target === dialog) dialog.close(); });

      // Montar a presença
      const form = document.querySelector("#k4-montar");
      const formato = document.querySelector("#k4-formato");
      const texto = document.querySelector("#k4-resumo-texto");
      const enviar = document.querySelector("#k4-enviar");

      const formatos = {
        master: {
          nome: "Patrono",
          texto: "Inclui o coquetel de encerramento, o Momento Porsche, e com ele a exclusividade em automóveis premium no evento.",
        },
        experiencia: {
          nome: "Anfitrião",
          texto: "Um ou mais momentos do dia assinados pela marca, como a mesa de personalização ou o cadastro de test drive.",
        },
        apoio: {
          nome: "Presença",
          texto: "Presença da marca ao lado do público, no credenciamento e na abertura.",
        },
      };
      const peso = { apoio: 1, experiencia: 2, master: 3 };

      function atualizar() {
        const linha = form.querySelector('input[name="linha"]:checked')?.value ?? "";
        const marcados = [...form.querySelectorAll('input[name="momento"]:checked')];
        const testdrive = form.elements.testdrive.checked;
        const obs = form.elements.obs.value.trim();

        let melhor = null;
        marcados.forEach((m) => {
          if (!melhor || peso[m.dataset.nivel] > peso[melhor]) melhor = m.dataset.nivel;
        });
        const escolhido = melhor ? formatos[melhor] : null;

        formato.textContent = escolhido ? escolhido.nome : "Marque ao menos um momento";
        texto.textContent = escolhido
          ? escolhido.texto + " Depois ajustamos tudo juntos."
          : "Assim que você escolher, mostramos o formato mais próximo. Depois ajustamos tudo juntos.";

        const linhas = ["Olá! Vi a proposta do RAROS preparada para a Stuttgart Porsche e quero conversar sobre esta composição:"];
        if (linha) linhas.push("• Linha: " + linha);
        if (marcados.length) linhas.push("• Momentos: " + marcados.map((m) => m.value).join(", "));
        if (escolhido) linhas.push("• Formato que combina: " + escolhido.nome);
        linhas.push("• Cadastro de test drive para depois do evento: " + (testdrive ? "sim" : "não"));
        if (obs) linhas.push("• Observações: " + obs);
        enviar.href = "https://wa.me/" + whatsapp + "?text=" + encodeURIComponent(linhas.join("\n"));
      }

      form.addEventListener("input", atualizar);
      form.addEventListener("change", atualizar);
      atualizar();
    </script>
  </body>
</html>
