function youtubeEmbed(url: string) {
  const id =
    url.match(/shorts\/([\w-]+)/)?.[1] ??
    url.match(/[?&]v=([\w-]+)/)?.[1] ??
    url.match(/youtu\.be\/([\w-]+)/)?.[1] ??
    "";
  return id ? `https://www.youtube.com/embed/${id}?autoplay=1` : url;
}

const totalSeguidores = evento.seguidores.reduce((s, n) => s + n, 0);
const seguidoresMil =
  (totalSeguidores / 1000).toLocaleString("pt-BR", { maximumFractionDigits: 1 }) + " mil";

const logo = ["svg", "png", "webp"]
  .map((ext) => `images/stuttgart/logo.${ext}`)
  .find((caminho) => existsSync(resolve(process.cwd(), "public", caminho)));

const capaFoto = existsSync(resolve(process.cwd(), "public", "images/stuttgart/capa.jpg"))
  ? "/images/stuttgart/capa.jpg"
  : h.capa;

const zap =
  "https://wa.me/" +
  evento.contato.whatsapp +
  "?text=" +
  encodeURIComponent("Olá! Vi a proposta do RAROS preparada para a Stuttgart Porsche e quero conversar sobre ela.");

const opcoesMomento = [
  ...h.dia.momentos
    .filter((m) => m.selecionavel)
    .map((m) => ({ id: m.id, hora: m.hora, nome: m.nome, ideia: m.ideia, nivel: m.nivel })),
  { id: h.dia.extra.id, hora: "A combinar", nome: h.dia.extra.nome, ideia: h.dia.extra.ideia, nivel: h.dia.extra.nivel },
];
