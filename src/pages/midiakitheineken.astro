      { id: "coquetel", hora: "18h00", nome: "Coquetel de encerramento", marca: true, nivel: "master", ideia: "O brinde final, assinado pela Heineken. Cheers to all: com a leveza da Heineken Ultimate, ou sem álcool, com a 0.0." },
    ],
    extra: {
      id: "lounge",
      nome: "Espaço de marca",
      nivel: "experiencia",
      ideia: "Exposição ou lounge da marca, se for do interesse da Heineken. Formato e local a combinar com o clube.",
