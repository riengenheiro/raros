 * Independente do /midiakit e do /midiakit002: dados e estilos próprios (classes .k3-).
 *
 * Como personalizar para outra marca: tudo que é específico da Heineken está no objeto `h`
 * (leitura da marca, pontos em comum, ideia por momento do dia, formatos e compromissos).
 * O restante (dados do evento) vem do objeto `evento`.
 *
 * Logo: se existir public/images/heineken/logo.(svg|png|webp), ele aparece no topo da capa.
 */
const evento = {
  nome: "RAROS",
  tema: "Inteligência Emocional para Liderar o Seu Negócio",
  data: "Sábado, 5 de dezembro de 2026",
  casa: "Tênis Clube de Campinas",
  endereco: "R. Cel. Quirino, 1346 — Cambuí, Campinas — SP, 13015-330",

