    momentos: [
      { id: "credenciamento", hora: "8h30", nome: "Credenciamento", marca: true, nivel: "apoio", ideia: "Boas-vindas com Heineken 0.0 gelada e material da marca na entrega do crachá." },
      { id: "abertura", hora: "9h00", nome: "Abertura e conteúdo", marca: false, nivel: "apoio", ideia: "O conteúdo fica livre de marca. Apenas a abertura cita a Heineken e a mensagem de moderação." },
