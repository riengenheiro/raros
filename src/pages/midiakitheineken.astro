/* ------------------------------------------------------------------ */

function youtubeEmbed(url: string) {
  const id =
    url.match(/shorts\/([\w-]+)/)?.[1] ??
    url.match(/[?&]v=([\w-]+)/)?.[1] ??
    url.match(/youtu\.be\/([\w-]+)/)?.[1] ??
    "";
  return id ? `https://www.youtube.com/embed/${id}?autoplay=1` : url;
}

const totalSeguidores = evento.seguidores.reduce((s, n) => s + n, 0);
const seguidoresMil =
  (totalSeguidores / 1000).toLocaleString("pt-BR", { maximumFractionDigits: 1 }) + " mil";

const logo = ["svg", "png", "webp"]
  .map((ext) => `images/heineken/logo.${ext}`)
  .find((caminho) => existsSync(resolve(process.cwd(), "public", caminho)));

const zap =
  "https://wa.me/" +
  evento.contato.whatsapp +
  "?text=" +
  encodeURIComponent("Olá! Vi a proposta do RAROS preparada para a Heineken e quero conversar sobre ela.");

const opcoesMomento = [
  ...h.dia.momentos.map((m) => ({ id: m.id, hora: m.hora, nome: m.nome, ideia: m.ideia, nivel: m.nivel })),
  { id: h.dia.extra.id, hora: "A combinar", nome: h.dia.extra.nome, ideia: h.dia.extra.ideia, nivel: h.dia.extra.nivel },
];
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#04180d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>Proposta de parceria para a Heineken | RAROS · Tênis Clube de Campinas</title>
    <meta
      name="description"
      content="Proposta de parceria do RAROS preparada para o Grupo Heineken Brasil: um encontro reservado de 140 lugares no Tênis Clube de Campinas."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="k3-body">
    <main class="k3">
      <!-- Capa -->
      <section class="k3-pag k3-capa" style="--capa: url('/images/mk/organizador.jpg')">
        <div class="k3-capa-topo">
          <div class="k3-wrap">
            <p class="k3-rotulo"><i class="k3-estrela" aria-hidden="true"></i>Proposta de parceria · 2026</p>
            {logo && <img class="k3-logo" src={`/${logo}`} alt={h.marca} />}
          </div>
        </div>
        <div class="k3-wrap k3-capa-texto">
          <p class="k3-capa-para">Preparada para o {h.empresa}</p>
          <h1 class="k3-capa-titulo">
            <span class="k3-sr">{evento.nome}: </span>Um dia de decisões, um brinde no fim.
          </h1>
          <p class="k3-capa-info">
            Evento da Diretoria Cultural do {evento.casa}<br />
            {evento.nome} · {evento.tema}<br />
            {evento.data} · {evento.casa}
          </p>
        </div>
      </section>

      <!-- Carta -->
      <section class="k3-pag k3-centro">
        <div class="k3-wrap">
          <div class="k3-carta">
            <p class="k3-num"><i class="k3-estrela" aria-hidden="true"></i>Antes de tudo</p>
            {h.carta.map((p) => <p class="k3-carta-texto">{p}</p>)}
            <div class="k3-carta-ass">
              <strong>{evento.contato.nome}</strong>
            </div>
          </div>
        </div>
      </section>

      <!-- 01 A marca -->
      <section class="k3-pag k3-floresta">
        <div class="k3-wrap">
          <p class="k3-num"><i class="k3-estrela" aria-hidden="true"></i>01 · O que estudamos</p>
          <h2>A Heineken que vimos de perto</h2>
          <figure class="k3-epigrafe" style="margin-top: 36px">
            <blockquote>
              <p>“{h.epigrafe.texto}”</p>
            </blockquote>
            <cite>{h.epigrafe.fonte}</cite>
          </figure>
          <div class="k3-pilares">
            {h.pilares.map((p) => (
              <article class="k3-pilar">
                <h3><i class="k3-estrela" aria-hidden="true"></i>{p.titulo}</h3>
                <p>{p.texto}</p>
                <p class="k3-pilar-dado">{p.dado}</p>
              </article>
            ))}
          </div>
          <p class="k3-fonte">{h.fontes}</p>
        </div>
      </section>

      <!-- 02 O que nos une -->
      <section class="k3-pag k3-claro">
        <div class="k3-wrap">
          <p class="k3-num"><i class="k3-estrela" aria-hidden="true"></i>02 · O que nos une</p>
          <h2>Seis pontos em que a Heineken e o RAROS se reconhecem</h2>
          <div class="k3-pares">
            <div class="k3-par-cab" aria-hidden="true">
              <span>A Heineken</span><span></span><span>O RAROS</span>
            </div>
            {h.encontros.map((e) => (
              <article class="k3-par">
                <h3>{e.titulo}</h3>
                <p>{e.heineken}</p>
                <span class="k3-par-seta" aria-hidden="true">→</span>
                <p>{e.raros}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- 03 O encontro -->
      <section class="k3-pag">
        <div class="k3-wrap">
          <p class="k3-num"><i class="k3-estrela" aria-hidden="true"></i>03 · O encontro</p>
          <h2>Cento e quarenta lugares. Uma única sala. As pessoas que decidem.</h2>
          <p class="k3-lead">
            O {evento.nome} reúne, por um dia, sócios do {evento.casa} e empresários convidados em torno de inteligência
            emocional aplicada aos negócios. Um ambiente reservado, pensado para conversas que viram parcerias.
          </p>

          <div class="k3-barra" role="img" aria-label={evento.composicao.map((c) => `${c.pct}% ${c.rotulo}`).join("; ")}>
            {evento.composicao.map((c, i) => <span class={`k3-seg k3-seg-${i + 1}`} style={`width: ${c.pct}%`}></span>)}
          </div>
          <ul class="k3-legenda">
            {evento.composicao.map((c, i) => (
              <li>
                <i class={`k3-seg k3-seg-${i + 1}`} aria-hidden="true"></i>
                <strong>{c.pct}%</strong>
                <span>{c.rotulo}</span>
              </li>
            ))}
          </ul>
          <p class="k3-linha">{evento.porte}.</p>
          <p class="k3-fonte">O Clube de Networking é uma ação idealizada e desenvolvida pela Diretoria Cultural do {evento.casa}.</p>

          <h3 class="k3-sub">O perfil de quem frequenta o clube</h3>
          <ul class="k3-grade k3-grade-4">
            {evento.perfilClube.map((n) => <li><strong>{n.valor}</strong><span>{n.rotulo}</span></li>)}
          </ul>
          <ul class="k3-grade k3-grade-3">
            {evento.clubeNumeros.map((n) => <li><strong>{n.valor}</strong><span>{n.rotulo}</span></li>)}
          </ul>
          <p class="k3-fonte">Fonte: dados do {evento.casa}. 95% do público acima de 18 anos.</p>
        </div>
      </section>

      <!-- 04 O dia -->
      <section class="k3-pag k3-claro">
        <div class="k3-wrap">
          <p class="k3-num"><i class="k3-estrela" aria-hidden="true"></i>04 · O dia da Heineken</p>
          <h2>Cada momento do dia, uma ideia para a marca</h2>
          <p class="k3-lead">
            {evento.data}, no {evento.casa}. {h.dia.detalhe}
          </p>
          <ol class="k3-dia">
            {h.dia.momentos.map((m) => (
              <li class={`k3-momento ${m.marca ? "k3-com-marca" : ""}`}>
                <strong>{m.hora}</strong>
                <i class="k3-estrela" aria-hidden="true"></i>
                <div>
                  <h3>{m.nome}</h3>
                  <p>{m.ideia}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="k3-ideia-geral"><strong>{h.dia.ideia}</strong></p>
          <p class="k3-fonte">{evento.endereco}</p>
        </div>
      </section>

      <!-- 05 Conteúdo -->
      <section class="k3-pag">
        <div class="k3-wrap">
          <p class="k3-num"><i class="k3-estrela" aria-hidden="true"></i>05 · Conteúdo</p>
          <h2>Quem conduz o dia</h2>
          <div class="k3-pals">
            {evento.palestrantes.map((p) => (
              <article class="k3-pal">
                <img src={p.foto} alt={p.nome} width="520" height="650" />
                <h3>{p.nome}</h3>
                <p class="k3-pal-papel">{p.papel}</p>
                <p class="k3-pal-texto">{p.texto}</p>
                <ul>
                  {p.numeros.map((n) => <li><strong>{n.valor}</strong><span>{n.rotulo}</span></li>)}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- 06 Formatos -->
      <section class="k3-pag k3-claro">
        <div class="k3-wrap">
          <p class="k3-num"><i class="k3-estrela" aria-hidden="true"></i>06 · Parceria</p>
          <h2>Três formatos para a Heineken estar presente</h2>
          <div class="k3-cotas">
            {h.cotas.map((c) => (
              <article class={`k3-cota ${c.destaque ? "k3-cota-destaque" : ""}`}>
                <h3>{c.nome}</h3>
                <p class="k3-cota-qtd">{c.quantidade}</p>
                <p class="k3-cota-resumo">{c.resumo}</p>
                <ul>{c.entregas.map((e) => <li>{e}</li>)}</ul>
                <p class="k3-cota-valor">Investimento apresentado em conversa</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- 07 Monte a presença -->
      <section class="k3-pag k3-floresta" id="montar">
        <div class="k3-wrap">
          <p class="k3-num"><i class="k3-estrela" aria-hidden="true"></i>07 · Sua presença, do seu jeito</p>
          <h2>Monte a presença da Heineken no RAROS</h2>
          <p class="k3-lead">
            Os formatos são um ponto de partida. Marque o que faz sentido para a marca e enviaremos a composição
            diretamente para a conversa. Nada aqui é definitivo: serve para começarmos pelo que a Heineken já tem em mente.
          </p>

          <form class="k3-montar" id="k3-montar" onsubmit="return false">
            <fieldset class="k3-passo">
              <legend>1. Qual Heineken estará presente?</legend>
              <div class="k3-opcoes k3-opcoes-2">
                {h.linhas.map((l, i) => (
                  <label class="k3-escolha">
                    <input type="radio" name="linha" value={l.valor} checked={i === 0} />
                    <span><strong>{l.valor}</strong><small>{l.texto}</small></span>
                  </label>
                ))}
              </div>
            </fieldset>

            <fieldset class="k3-passo">
              <legend>
                2. Em quais momentos?
                <small>Marque quantos quiser.</small>
              </legend>
              <div class="k3-opcoes k3-opcoes-2">
                {opcoesMomento.map((m) => (
                  <label class="k3-escolha">
                    <input type="checkbox" name="momento" value={m.nome} data-nivel={m.nivel} />
                    <span><em>{m.hora}</em><strong>{m.nome}</strong><small>{m.ideia}</small></span>
                  </label>
                ))}
              </div>
            </fieldset>

            <fieldset class="k3-passo">
              <legend>
                3. Algo mais que a Heineken gostaria de incluir?
                <small>Uma ação de degustação, um convidado, uma mensagem específica.</small>
              </legend>
              <textarea class="k3-campo" name="obs" rows="3" placeholder="Escreva aqui, se quiser."></textarea>
            </fieldset>

            <div class="k3-resumo" aria-live="polite">
              <p class="k3-resumo-rotulo">Formato que combina com a sua escolha</p>
              <p class="k3-resumo-formato" id="k3-formato">Marque ao menos um momento</p>
              <p class="k3-resumo-texto" id="k3-resumo-texto">
                Assim que você escolher, mostramos o formato mais próximo. Depois ajustamos tudo juntos.
              </p>
              <a class="k3-botao" id="k3-enviar" href={zap}>Enviar esta composição</a>
            </div>
          </form>
        </div>
      </section>

      <!-- 08 Compromisso -->
      <section class="k3-pag k3-claro">
        <div class="k3-wrap">
          <p class="k3-num"><i class="k3-estrela" aria-hidden="true"></i>08 · Nosso compromisso</p>
          <h2>Cuidar da marca é parte da proposta</h2>
          <p class="k3-lead">
            Sabemos o que a Heineken defende sobre consumo responsável. Por isso assumimos quatro compromissos desde já.
          </p>
          <ul class="k3-compromissos">
            {h.compromissos.map((c) => (
              <li>
                <strong><i class="k3-estrela" aria-hidden="true"></i>{c.titulo}</strong>
                <span>{c.texto}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- 09 Realização e visibilidade -->
      <section class="k3-pag">
        <div class="k3-wrap">
          <p class="k3-num"><i class="k3-estrela" aria-hidden="true"></i>09 · Realização</p>
          <h2>Diretoria Cultural</h2>
          <p class="k3-lead">O RAROS é um evento da Diretoria Cultural do {evento.realizacao}.</p>
          <article class="k3-cultural">
            <img src="/images/mk/ana-clara.png" alt="Ana Clara de Mello e Silva, Diretora Cultural do Tênis Clube de Campinas" width="640" height="800" />
            <div>
              <span>Diretora Cultural do Tênis Clube de Campinas</span>
              <strong>Ana Clara de Mello e Silva</strong>
              <p>O encontro acontece dentro da proposta da Diretoria Cultural. O Clube de Networking é uma ação idealizada e desenvolvida por esta diretoria.</p>
            </div>
          </article>
          <ul class="k3-diretoria">
            {evento.diretoria.map((d) => <li><span>{d.cargo}</span><strong>{d.nome}</strong></li>)}
          </ul>

          <div class="k3-organiza">
            <h3 class="k3-sub">Quem está Organizando o Evento:</h3>
            <strong>Ricardo Farias Alexandre</strong>
            <span>G&R INSTITUTO EDUCACIONAL</span>
          </div>

          <h3 class="k3-sub">Visibilidade antes do evento</h3>
          <div class="k3-visib">
            <p class="k3-visib-num">
              <strong>{seguidoresMil}</strong>
              <span>seguidores somados nos perfis dos palestrantes e do clube</span>
            </p>
            <p>
              Além da página oficial do evento e das telas digitais do clube, vistas por mais de 1.200 frequentadores por dia.
            </p>
          </div>

          <h3 class="k3-sub">Edições anteriores</h3>
          <p class="k3-fonte" style="margin: -8px 0 16px">Registros de edições realizadas em outros locais.</p>
          <div class="k3-videos">
            {evento.videos.map((v, i) => (
              <button
                type="button"
                class="k3-video"
                data-video={youtubeEmbed(v.url)}
                data-formato={v.url.includes("/shorts/") ? "vertical" : "horizontal"}
                data-titulo={`${v.titulo} · vídeo ${i + 1}`}
              >
                <img src={v.imagem} alt="" width="405" height="720" />
                <span class="k3-play" aria-hidden="true"></span>
                <span class="k3-video-txt">Assistir · vídeo {i + 1}</span>
              </button>
            ))}
          </div>
        </div>
      </section>

      <!-- Contato -->
      <section class="k3-pag k3-final">
        <div class="k3-wrap">
          <div class="k3-contato">
            <p class="k3-rotulo"><i class="k3-estrela" aria-hidden="true"></i>Será uma honra conversar com a Heineken</p>
            <p class="k3-contato-nome">{evento.contato.nome}</p>
            <p><a href={zap}>WhatsApp {evento.contato.telefone}</a></p>
            <p><a href={`mailto:${evento.contato.email}`}>{evento.contato.email}</a></p>
            <a class="k3-botao" href={zap}>Agendar uma conversa</a>
          </div>
          <p class="k3-rodape">
            {evento.nome} · {evento.casa} · {evento.endereco}
          </p>
        </div>
      </section>
    </main>

    <dialog class="k3-player" id="k3-player">
      <form method="dialog" class="k3-player-barra">
        <p class="k3-player-titulo"></p>
        <button type="submit" class="k3-player-fechar">Fechar</button>
      </form>
      <iframe title="Vídeo" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>
    </dialog>

    <script is:inline define:vars={{ whatsapp: evento.contato.whatsapp }}>
      // Janela de vídeo
      const dialog = document.querySelector("#k3-player");
      const frame = dialog.querySelector("iframe");
      const titulo = dialog.querySelector(".k3-player-titulo");

      document.querySelectorAll(".k3-video").forEach((botao) => {
        botao.addEventListener("click", () => {
          const nome = botao.dataset.titulo || "Vídeo";
          frame.title = nome;
          titulo.textContent = nome;
          dialog.dataset.formato = botao.dataset.formato || "horizontal";
          frame.src = botao.dataset.video || "";
          dialog.showModal();
        });
      });
      dialog.addEventListener("close", () => { frame.src = ""; });
      dialog.addEventListener("click", (evento) => { if (evento.target === dialog) dialog.close(); });

      // Montar a presença
      const form = document.querySelector("#k3-montar");
      const formato = document.querySelector("#k3-formato");
      const texto = document.querySelector("#k3-resumo-texto");
      const enviar = document.querySelector("#k3-enviar");

      const formatos = {
        master: {
          nome: "Parceiro Master",
          texto: "Inclui o coquetel de encerramento e, com ele, a exclusividade em cervejas no evento.",
        },
        experiencia: {
          nome: "Parceiro de Experiência",
          texto: "Um ou mais momentos do dia assinados pela marca, como coffee break ou almoço.",
        },
        apoio: {
          nome: "Apoio",
          texto: "Presença da marca ao lado do público, no credenciamento e na abertura.",
        },
      };
      const peso = { apoio: 1, experiencia: 2, master: 3 };

      function atualizar() {
        const linha = form.querySelector('input[name="linha"]:checked')?.value ?? "";
        const marcados = [...form.querySelectorAll('input[name="momento"]:checked')];
        const obs = form.elements.obs.value.trim();

        let melhor = null;
        marcados.forEach((m) => {
          if (!melhor || peso[m.dataset.nivel] > peso[melhor]) melhor = m.dataset.nivel;
        });
        const escolhido = melhor ? formatos[melhor] : null;

        formato.textContent = escolhido ? escolhido.nome : "Marque ao menos um momento";
        texto.textContent = escolhido
          ? escolhido.texto + " Depois ajustamos tudo juntos."
          : "Assim que você escolher, mostramos o formato mais próximo. Depois ajustamos tudo juntos.";

        const linhas = ["Olá! Vi a proposta do RAROS preparada para a Heineken e quero conversar sobre esta composição:"];
        if (linha) linhas.push("• Linha: " + linha);
        if (marcados.length) linhas.push("• Momentos: " + marcados.map((m) => m.value).join(", "));
        if (escolhido) linhas.push("• Formato que combina: " + escolhido.nome);
        if (obs) linhas.push("• Observações: " + obs);
        enviar.href = "https://wa.me/" + whatsapp + "?text=" + encodeURIComponent(linhas.join("\n"));
      }

      form.addEventListener("input", atualizar);
      form.addEventListener("change", atualizar);
      atualizar();
    </script>
  </body>
</html>
