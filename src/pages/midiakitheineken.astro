    { titulo: "Edição anterior", url: "https://youtube.com/shorts/nmYrXJ7qWfY", imagem: "/images/mk/evento-anterior-2.jpg" },
  ],
  seguidores: [22000, 61800, 14600],

  contato: {
    nome: "Ricardo Farias Alexandre",
